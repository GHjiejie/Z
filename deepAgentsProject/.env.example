DEEPAGENT_DB_PATH=./data/deepagent.db
# Production must use PostgreSQL. When set, DATABASE_URL takes precedence over
# DEEPAGENT_DB_PATH and also backs durable LangGraph checkpoints.
DATABASE_URL=
DATABASE_URL_FILE=
DEEPAGENT_DB_CONNECT_TIMEOUT_SECONDS=5
DEEPAGENT_DB_STATEMENT_TIMEOUT_MS=15000
DEEPAGENT_DB_LOCK_TIMEOUT_MS=5000
DEEPAGENT_DATA_DIR=./data
# Development defaults to automatic migrations. Production defaults to false;
# run `make migrate` as a dedicated release job before starting API replicas.
DEEPAGENT_AUTO_MIGRATE=true
# Use `all` only for local development. Production API and Worker deployments
# set this to `api` and `worker` respectively and share PostgreSQL.
DEEPAGENT_PROCESS_ROLE=all
DEEPAGENT_QUEUE_LEASE_SECONDS=300
DEEPAGENT_QUEUE_POLL_SECONDS=0.25
DEEPAGENT_RUN_LEASE_SECONDS=30
DEEPAGENT_RUN_RECOVERY_LIMIT=3
DEEPAGENT_RECONCILE_SECONDS=2
DEEPAGENT_INGESTION_LEASE_SECONDS=30
DEEPAGENT_INGESTION_RECOVERY_LIMIT=3
# Logical retained document bytes; failed/expired objects remain charged until
# verified deletion. This does not measure OSS historical-version billing.
DEEPAGENT_UPLOAD_TENANT_BYTES=10737418240
DEEPAGENT_UPLOAD_PROJECT_BYTES=5368709120
DEEPAGENT_UPLOAD_USER_BYTES=1073741824
DEEPAGENT_UPLOAD_TENANT_PENDING=1000
DEEPAGENT_UPLOAD_PROJECT_PENDING=200
DEEPAGENT_UPLOAD_USER_PENDING=50
# All workers must share these limits; claims are serialized in PostgreSQL.
DEEPAGENT_UPLOAD_GLOBAL_RUNNING=8
DEEPAGENT_UPLOAD_TENANT_RUNNING=4
DEEPAGENT_UPLOAD_PROJECT_RUNNING=2
DEEPAGENT_UPLOAD_USER_RUNNING=2
DEEPAGENT_UPLOAD_METADATA_PER_PROCESS=8
DEEPAGENT_UPLOAD_PENDING_SECONDS=86400
DEEPAGENT_UPLOAD_GRANT_SECONDS=900
DEEPAGENT_ENVIRONMENT=development
DEEPAGENT_CORS_ORIGINS=http://localhost:5173
DEEPAGENT_ALLOWED_HOSTS=localhost,127.0.0.1
DEEPAGENT_MAX_REQUEST_BYTES=115343360
DEEPAGENT_CSRF_ENABLED=true
DEEPAGENT_HSTS_ENABLED=false
# Keep false unless an authenticated reverse proxy strips caller-supplied
# identity headers and injects authoritative X-Tenant/X-Project/X-User/X-Roles.
DEEPAGENT_TRUST_IDENTITY_HEADERS=false
# Required in production when trusted identity headers are enabled. The proxy
# signs tenant/project/environment/user/roles/timestamp with HMAC-SHA256.
DEEPAGENT_IDENTITY_HEADER_SECRET=
# Production alternative: mount a mode-0400 file and leave the inline value empty.
DEEPAGENT_IDENTITY_HEADER_SECRET_FILE=
# Local demo only. Production must supply an authenticated identity adapter.
DEEPAGENT_ALLOW_DEMO_IDENTITY=false
# The built-in super administrator is created only when the admin account does
# not exist. Change this value before the first production startup.
DEEPAGENT_BOOTSTRAP_ADMIN_PASSWORD=Console1@
DEEPAGENT_BOOTSTRAP_ADMIN_PASSWORD_FILE=
DEEPAGENT_SESSION_TTL_HOURS=12
# Password and sign-in policy.
DEEPAGENT_PASSWORD_MAX_AGE_DAYS=90
DEEPAGENT_MAX_FAILED_LOGINS=5
DEEPAGENT_LOGIN_LOCKOUT_MINUTES=15
DEEPAGENT_LOGIN_RATE_WINDOW_MINUTES=15
# Persist last-seen activity at most once per interval to avoid hot-row writes.
DEEPAGENT_SESSION_LAST_SEEN_SECONDS=60
# Enable only when the console and API are served over HTTPS.
DEEPAGENT_SESSION_COOKIE_SECURE=false
DEEPAGENT_SESSION_COOKIE_SAMESITE=lax
DEEPAGENT_CSRF_COOKIE_NAME=deepagent_csrf
# Optional os.pathsep-separated directories containing <plugin>/plugin.json bundles.
DEEPAGENT_PLUGIN_PATHS=

# Operator-approved model profiles (JSON array; no inline credentials).
# Registered models pin a profile hash into the Agent plan. See docs/model-governance.md.
DEEPAGENT_MODEL_PROFILES_FILE=
# Each profile references OPENAI_API_KEY or DEEPAGENT_MODEL_KEY_<NAME>.
# Production supplies the corresponding *_FILE, never a key in this config file.
DEEPAGENT_MODEL_KEY_PRIMARY_FILE=

# Coding Agent. Local working-directory selection is restricted to these
# os.pathsep-separated roots. A selected folder does not need to be a Git
# repository. Docker is required; no host path is mounted into the container.
DEEPAGENT_REPOSITORY_ROOTS=
# Comma-separated exact HTTPS/SSH origins. Required for ANY remote repository
# access in production; empty development settings allow public addresses only.
DEEPAGENT_REPOSITORY_ALLOWED_ORIGINS=
# Optional public trust files. No client private keys, tokens or ambient SSH agent.
DEEPAGENT_REPOSITORY_CA_FILE=
DEEPAGENT_REPOSITORY_SSH_KNOWN_HOSTS_FILE=
DEEPAGENT_CODING_IMAGE=deepagent/coding-runtime:0.1.0
DEEPAGENT_CODING_AUTO_BUILD=true
# Production uses the separately deployed sandbox service. The service account
# token and mTLS private key are mounted files, never persisted by the platform.
DEEPAGENT_SANDBOX_PROVIDER=docker
DEEPAGENT_SANDBOX_SERVICE_URL=
DEEPAGENT_SANDBOX_SERVICE_TOKEN_FILE=
DEEPAGENT_SANDBOX_CA_FILE=
DEEPAGENT_SANDBOX_CLIENT_CERT_FILE=
DEEPAGENT_SANDBOX_CLIENT_KEY_FILE=
DEEPAGENT_SANDBOX_TIMEOUT_SECONDS=30
# Sandbox Service only: a dedicated PostgreSQL login with SELECT on the lease
# view, no base-table privileges, and sslmode=verify-full.
SANDBOX_LEASE_DATABASE_URL_FILE=

# Real streaming model runtime. Supported API styles: chat_completions,
# responses, and anthropic_messages. Values may also live in the workspace-level
# .env one directory above this project.
OPENAI_BASE_URL=
# Required in production: explicit scheme/host/port origins (no API path).
# All provider redirects are rejected, including redirects to the same origin.
DEEPAGENT_MODEL_ALLOWED_ORIGINS=
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
MODEL=
MODEL_API_STYLE=chat_completions
MODEL_AUTH_STYLE=auto
MODEL_TIMEOUT_SECONDS=180
MODEL_MAX_COMPLETION_TOKENS=4096
MODEL_HISTORY_MAX_CHARACTERS=16000
MODEL_USER_INPUT_MAX_CHARACTERS=32000
MODEL_TEMPERATURE=0.7
# Chat Completions reasoning controls (MiniMax and compatible providers).
MODEL_REASONING_SPLIT=true
MODEL_REASONING_EFFORT=
# Responses API reasoning summary: auto, concise, detailed, or blank to omit.
MODEL_REASONING_SUMMARY=auto
# Anthropic Messages extended-thinking controls.
MODEL_ANTHROPIC_VERSION=2023-06-01
MODEL_ANTHROPIC_THINKING_MODE=enabled
MODEL_ANTHROPIC_THINKING_BUDGET_TOKENS=2048
MODEL_ANTHROPIC_THINKING_DISPLAY=
# Prices are pinned in the published model/Agent execution plan. The legacy
# MODEL_INPUT_PRICE_PER_MILLION / MODEL_OUTPUT_PRICE_PER_MILLION are not used.

# Ambiguous first-turn intent classification. Obvious intent rules do not call
# the model; model timeout/invalid output falls back to a confirmation flow.
INTENT_CLASSIFIER_TIMEOUT_SECONDS=4

# Knowledge/RAG reference mode. Set to oss in production.
KNOWLEDGE_OBJECT_STORE=local
KNOWLEDGE_EMBEDDING_PROVIDER=hash

# Alibaba Cloud OSS production configuration. Credentials come from the
# Alibaba Cloud default credential chain (RAM Role/OIDC/STS/environment).
ALIYUN_OSS_BUCKET=jie-agent-file
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_INTERNAL_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
ALIYUN_OSS_USE_INTERNAL_ENDPOINT=false

# Optional OpenAI-compatible embedding endpoint.
KNOWLEDGE_EMBEDDING_BASE_URL=
KNOWLEDGE_EMBEDDING_ALLOWED_ORIGINS=
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_API_KEY_FILE=
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_DIMENSIONS=
VITE_API_BASE=

# Production uploads and generated archives are scanned before use or storage.
DEEPAGENT_CONTENT_SCANNER=disabled
CLAMAV_UNIX_SOCKET=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
CLAMAV_MAX_BYTES=536870912

# Dedicated sandbox-host service only. Do not give the API/worker Docker access.
SANDBOX_STATE_PATH=/var/lib/deepagent/sandboxes.db
SANDBOX_TLS_CERT_FILE=
SANDBOX_TLS_KEY_FILE=
SANDBOX_TLS_CLIENT_CA_FILE=
SANDBOX_MAX_INSTANCES=32
SANDBOX_MAX_CPUS=4
SANDBOX_MAX_MEMORY_MB=8192
SANDBOX_MAX_DISK_MB=10240
SANDBOX_MAX_PIDS=256
SANDBOX_MAX_TTL_SECONDS=86400
SANDBOX_MAX_ARCHIVE_BYTES=104857600

# Readiness: cached, single-flight probes; /livez never checks dependencies.
DEEPAGENT_HEALTH_INTERVAL=5
DEEPAGENT_HEALTH_TIMEOUT=2
DEEPAGENT_HEALTH_STALE_AFTER=20
DEEPAGENT_HEALTH_RUNTIME_QUEUE_LIMIT=1000
DEEPAGENT_HEALTH_KNOWLEDGE_QUEUE_LIMIT=500
DEEPAGENT_HEALTH_RUNTIME_WAIT_SECONDS=300
DEEPAGENT_HEALTH_KNOWLEDGE_WAIT_SECONDS=900

# Outstanding-task admission (not model-call billing quotas).
# Keep these values identical across API/Worker replicas. Zero closes admission.
DEEPAGENT_ADMISSION_RUNTIME_TENANT_ACTIVE=1000
DEEPAGENT_ADMISSION_RUNTIME_PROJECT_ACTIVE=200
DEEPAGENT_ADMISSION_RUNTIME_USER_ACTIVE=100
DEEPAGENT_ADMISSION_RUNTIME_TENANT_QUEUED=500
DEEPAGENT_ADMISSION_RUNTIME_PROJECT_QUEUED=100
DEEPAGENT_ADMISSION_RUNTIME_USER_QUEUED=50
DEEPAGENT_ADMISSION_KNOWLEDGE_TENANT_ACTIVE=200
DEEPAGENT_ADMISSION_KNOWLEDGE_PROJECT_ACTIVE=100
DEEPAGENT_ADMISSION_KNOWLEDGE_USER_ACTIVE=20

# One document per subprocess. Production additionally requires Linux
# Landlock ABI >=3 and libseccomp.so.2; see docs/document-parsing.md.
# Blank = required in production, resource-only in development. Production
# rejects false; Linux development/acceptance can explicitly set true.
DEEPAGENT_PARSER_OS_SANDBOX=
DEEPAGENT_PARSER_TIMEOUT_SECONDS=30.0
DEEPAGENT_PARSER_CPU_SECONDS=15
DEEPAGENT_PARSER_MEMORY_BYTES=536870912
DEEPAGENT_PARSER_MAX_INPUT_BYTES=104857600
DEEPAGENT_PARSER_MAX_OUTPUT_BYTES=16777216
DEEPAGENT_PARSER_MAX_EXPANDED_BYTES=67108864
DEEPAGENT_PARSER_MAX_ARCHIVE_ENTRIES=2048
DEEPAGENT_PARSER_MAX_COMPRESSION_RATIO=200
DEEPAGENT_PARSER_MAX_PAGES=500
DEEPAGENT_PARSER_MAX_BLOCKS=20000
DEEPAGENT_PARSER_MAX_TEXT_CHARACTERS=2000000
DEEPAGENT_PARSER_MAX_CHUNKS=5000
DEEPAGENT_PARSER_CHUNK_CHARACTERS=2200
DEEPAGENT_PARSER_OVERLAP_CHARACTERS=220
DEEPAGENT_PARSER_MAX_CONCURRENT=2
# Observability: metrics disabled without a distinct collector token.
# Production requires file-backed METRICS/OTLP tokens and an approved HTTPS endpoint.
# Production also requires OTEL_PYTHON_SDK_INTERNAL_METRICS_ENABLED=true;
# see deploy/platform.env.example and docs/observability.md.
DEEPAGENT_METRICS_TOKEN_FILE=
DEEPAGENT_TRACE_SAMPLE_RATE=0.1
DEEPAGENT_OTLP_TRACES_ENDPOINT=
DEEPAGENT_OTLP_TOKEN_FILE=
DEEPAGENT_OTLP_CA_FILE=
DEEPAGENT_WORKER_METRICS_PORT=0
DEEPAGENT_WORKER_METRICS_HOST=127.0.0.1
DEEPAGENT_METRICS_TLS_CERT_FILE=
DEEPAGENT_METRICS_TLS_KEY_FILE=
