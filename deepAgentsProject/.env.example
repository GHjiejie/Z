DEEPAGENT_DB_PATH=./data/deepagent.db
DEEPAGENT_CORS_ORIGINS=http://localhost:5173
# Optional os.pathsep-separated directories containing <plugin>/plugin.json bundles.
DEEPAGENT_PLUGIN_PATHS=

# Knowledge/RAG reference mode. Set to oss in production.
KNOWLEDGE_OBJECT_STORE=local
KNOWLEDGE_EMBEDDING_PROVIDER=hash

# Alibaba Cloud OSS production configuration. Credentials come from the
# Alibaba Cloud default credential chain (RAM Role/OIDC/STS/environment).
ALIYUN_OSS_BUCKET=jie-agent-file
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_INTERNAL_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
ALIYUN_OSS_USE_INTERNAL_ENDPOINT=false

# Optional OpenAI-compatible embedding endpoint.
KNOWLEDGE_EMBEDDING_BASE_URL=
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_DIMENSIONS=
VITE_API_BASE=
