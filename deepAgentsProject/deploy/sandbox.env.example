DEEPAGENT_CODING_IMAGE=approved-registry.example.com/deepagent-coding@sha256:REPLACE_WITH_APPROVED_DIGEST
DEEPAGENT_SANDBOX_SERVICE_TOKEN_FILE=/run/secrets/sandbox-token
SANDBOX_LEASE_DATABASE_URL_FILE=/run/secrets/lease-database-url
SANDBOX_TLS_CERT_FILE=/run/secrets/sandbox-cert
SANDBOX_TLS_KEY_FILE=/run/secrets/sandbox-key
SANDBOX_TLS_CLIENT_CA_FILE=/run/secrets/controller-ca
SANDBOX_MAX_INSTANCES=32
SANDBOX_MAX_CPUS=4
SANDBOX_MAX_MEMORY_MB=8192
SANDBOX_MAX_DISK_MB=10240
SANDBOX_MAX_PIDS=256
SANDBOX_MAX_TTL_SECONDS=86400
SANDBOX_MAX_ARCHIVE_BYTES=104857600
