# Non-secret application configuration. Replace every example hostname/model.
DEEPAGENT_AUTO_MIGRATE=false
DEEPAGENT_ALLOW_DEMO_IDENTITY=false
DEEPAGENT_TRUST_IDENTITY_HEADERS=false
DEEPAGENT_SESSION_COOKIE_SECURE=true
DEEPAGENT_CSRF_ENABLED=true
DEEPAGENT_CORS_ORIGINS=https://console.example.com
# Loopback Host is needed for the internal liveness probe, not for public ingress.
DEEPAGENT_ALLOWED_HOSTS=console.example.com,127.0.0.1
DATABASE_URL_FILE=/run/secrets/database-url
DEEPAGENT_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap-password
OPENAI_API_KEY_FILE=/run/secrets/model-api-key
OPENAI_BASE_URL=https://model.internal.example.com/v1
MODEL=approved-model-id
DEEPAGENT_MODEL_ALLOWED_ORIGINS=https://model.internal.example.com
KNOWLEDGE_OBJECT_STORE=oss
ALIYUN_OSS_BUCKET=approved-versioned-bucket
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_USE_INTERNAL_ENDPOINT=true
# Schema 20: tune and keep identical on API/Worker replicas. Logical retained
# bytes include failures/expiry, not all OSS historical-version billing.
DEEPAGENT_UPLOAD_TENANT_BYTES=10737418240
DEEPAGENT_UPLOAD_PROJECT_BYTES=5368709120
DEEPAGENT_UPLOAD_USER_BYTES=1073741824
DEEPAGENT_UPLOAD_TENANT_PENDING=1000
DEEPAGENT_UPLOAD_PROJECT_PENDING=200
DEEPAGENT_UPLOAD_USER_PENDING=50
DEEPAGENT_UPLOAD_GLOBAL_RUNNING=8
DEEPAGENT_UPLOAD_TENANT_RUNNING=4
DEEPAGENT_UPLOAD_PROJECT_RUNNING=2
DEEPAGENT_UPLOAD_USER_RUNNING=2
DEEPAGENT_UPLOAD_METADATA_PER_PROCESS=8
DEEPAGENT_UPLOAD_PENDING_SECONDS=86400
DEEPAGENT_UPLOAD_GRANT_SECONDS=900
# Provide a workload/RAM identity on the deployment platform, not long-lived AK/SK.
KNOWLEDGE_EMBEDDING_PROVIDER=openai_compatible
KNOWLEDGE_EMBEDDING_API_KEY_FILE=/run/secrets/embedding-api-key
KNOWLEDGE_EMBEDDING_BASE_URL=https://embedding.internal.example.com/v1
KNOWLEDGE_EMBEDDING_MODEL=approved-embedding-model
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_EMBEDDING_ALLOWED_ORIGINS=https://embedding.internal.example.com
DEEPAGENT_SANDBOX_PROVIDER=remote
# Empty disables remote repository access. Set exact approved public origins,
# e.g. https://github.com; no wildcards, credentials, paths, or private addresses.
DEEPAGENT_REPOSITORY_ALLOWED_ORIGINS=
# Optional public CA / SSH host-key overlays: see docs/repository-network.md.
DEEPAGENT_SANDBOX_SERVICE_URL=https://sandbox.internal.example.com:8443
DEEPAGENT_SANDBOX_SERVICE_TOKEN_FILE=/run/secrets/sandbox-token
DEEPAGENT_SANDBOX_CA_FILE=/run/secrets/sandbox-ca
DEEPAGENT_SANDBOX_CLIENT_CERT_FILE=/run/secrets/controller-cert
DEEPAGENT_SANDBOX_CLIENT_KEY_FILE=/run/secrets/controller-key
DEEPAGENT_CODING_IMAGE=approved-registry.example.com/deepagent-coding@sha256:REPLACE_WITH_APPROVED_DIGEST
DEEPAGENT_CONTENT_SCANNER=clamav
CLAMAV_HOST=clamav.internal.example.com
DEEPAGENT_PARSER_OS_SANDBOX=true
# Approved internal collector; no prompt/document/command payloads are exported.
DEEPAGENT_METRICS_TOKEN_FILE=/run/secrets/metrics-token
DEEPAGENT_TRACE_SAMPLE_RATE=0.1
OTEL_PYTHON_SDK_INTERNAL_METRICS_ENABLED=true
DEEPAGENT_OTLP_TRACES_ENDPOINT=https://telemetry.internal.example.com:4318/v1/traces
DEEPAGENT_OTLP_TOKEN_FILE=/run/secrets/otlp-token
DEEPAGENT_OTLP_CA_FILE=/run/secrets/telemetry-ca
# Worker only: no host/public port mapping; scrape over the private network.
DEEPAGENT_WORKER_METRICS_HOST=0.0.0.0
DEEPAGENT_WORKER_METRICS_PORT=9108
DEEPAGENT_METRICS_TLS_CERT_FILE=/run/secrets/worker-metrics-cert
DEEPAGENT_METRICS_TLS_KEY_FILE=/run/secrets/worker-metrics-key
