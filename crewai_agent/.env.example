# 复制为本目录 .env，填写密钥和服务支持的模型名称。
# 进程环境变量优先于此文件；不会自动加载仓库根目录 .env。
OPENAI_API_KEY=
MODEL=

# 可替换为 OpenAI 兼容网关地址（通常包含 /v1）。
OPENAI_BASE_URL=https://api.openai.com/v1

# completions = Chat Completions；responses = Responses API。
OPENAI_API=completions

# 可选：直连模型网关时填写代理绕过列表，沿用现有项目或网络配置。
# no_proxy=localhost,127.0.0.1,your-gateway.example.com
