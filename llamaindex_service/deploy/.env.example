# Run from repository root: uv run --group rag ...
RAG_ENVIRONMENT=development
RAG_DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:55432/rag
RAG_AUTH_MODE=dev
RAG_AUTO_MIGRATE=false
# mock exercises the pipeline offline; it does not provide semantic answers.
RAG_MODEL_MODE=mock
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_REVISION=1
RAG_EMBEDDING_DIMENSION=1536
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=
RAG_STORAGE_BACKEND=local
RAG_STORAGE_PATH=llamaindex_service/data/objects
# Live generation uses root chat_models.chat.chat_model and its OPENAI_API_KEY,
# OPENAI_BASE_URL, MODEL variables. No real credentials belong in this file.
# JWT mode uses an RSA/EC public key, or @/absolute/path/public-key.pem.
RAG_JWT_PUBLIC_KEY=
RAG_JWT_ISSUER=
RAG_JWT_AUDIENCE=
# Optional private object storage uses boto3's normal credential chain.
RAG_S3_BUCKET=
RAG_S3_REGION=us-east-1
# Optional reranker exposes POST /rerank with model/query/documents/top_n.
RAG_RERANK_BASE_URL=
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=
