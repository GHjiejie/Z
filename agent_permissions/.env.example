# Project-local model settings. Copy to agent_permissions/.env and set the key.
# The project uses Responses API.
AGENT_USERS_LLM_BASE_URL=https://api.wylon.cn/v1
AGENT_USERS_LLM_API_KEY=replace_with_your_api_key
AGENT_USERS_LLM_MODEL=ZhipuAI/GLM-5.3

# LangSmith tracing for this project only. Enable after setting your key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-permissions
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set this for organization API keys / keys linked to multiple workspaces.
LANGSMITH_WORKSPACE_ID=
# Hide complete prompts or responses when needed; credential fields are masked.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
