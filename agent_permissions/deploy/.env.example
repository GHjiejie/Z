# Generate a private deploy/.env with:
# uv run python -m agent_permissions.setup_postgres
AGENT_USERS_POSTGRES_DB=agent_users
AGENT_USERS_POSTGRES_USER=agent_users
AGENT_USERS_POSTGRES_PORT=55432
AGENT_USERS_POSTGRES_PASSWORD=replace-with-generated-password
AGENT_USERS_DATABASE_URL=postgresql://agent_users:replace-with-generated-password@127.0.0.1:55432/agent_users
AGENT_USERS_DB_POOL_MIN_SIZE=2
AGENT_USERS_DB_POOL_MAX_SIZE=10
AGENT_USERS_DB_POOL_TIMEOUT_SECONDS=3.0
AGENT_USERS_DB_POOL_MAX_WAITING=20
AGENT_USERS_DB_POOL_STARTUP_TIMEOUT_SECONDS=30.0
AGENT_USERS_DB_POOL_MAX_IDLE_SECONDS=300.0
AGENT_USERS_DB_POOL_MAX_LIFETIME_SECONDS=1800.0
AGENT_USERS_DB_POOL_RECONNECT_TIMEOUT_SECONDS=60.0
AGENT_USERS_DB_POOL_CLOSE_TIMEOUT_SECONDS=5.0
