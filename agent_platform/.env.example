# Local development. Copy to agent_platform/.env and replace blank secrets.
PLATFORM_MODE=local
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=
# Explicit platform operators only. A tenant admin is not a platform operator.
# Add the initial operator email here before running the explicit init command.
PLATFORM_OPERATOR_EMAILS=
# make start creates this persistent Fernet key once in the ignored .env (0600).
# Back up the key separately from PostgreSQL. Never regenerate it on a restart.
PLATFORM_SECRET_ENCRYPTION_KEY=
PLATFORM_DATABASE_URL=sqlite:///agent_platform/.data/platform.db
PLATFORM_REDIS_URL=
PLATFORM_LITELLM_URL=
PLATFORM_LITELLM_KEY=
# External gateway mode requires an explicitly restricted inference key above;
# OPENAI_API_KEY from the repository .env is never passed to API or Worker.
# Managed make start sets this automatically. External mode may set its own UI.
PLATFORM_LITELLM_ADMIN_URL=
# Local startup falls back to MODEL from the repository root .env.
PLATFORM_DEFAULT_MODEL=
# Optional platform quote in USD / million tokens. Set both to auto-register the
# default model on startup. These are platform prices, not upstream billing data.
PLATFORM_DEFAULT_MODEL_INPUT_PRICE=
PLATFORM_DEFAULT_MODEL_OUTPUT_PRICE=
# Optional egress binding; 0.0.0.0 selects IPv4 on networks with broken IPv6.
PLATFORM_GATEWAY_LOCAL_ADDRESS=
PLATFORM_EMBEDDED_WORKER=false
PLATFORM_WORKER_CONCURRENCY=4
# Only gateway-sync receives these control-plane settings. Managed local startup
# obtains them from .data/local/gateway/.env.control without printing secrets.
PLATFORM_GATEWAY_CONTROL_URL=
PLATFORM_GATEWAY_CONTROL_KEY=
PLATFORM_GATEWAY_SYNC_INTERVAL=2
PLATFORM_MAINTENANCE_INTERVAL=30
PLATFORM_EXPORT_TTL_SECONDS=86400
PLATFORM_DELETION_RETENTION_DAYS=30
PLATFORM_SECURE_COOKIES=false
PLATFORM_RUN_TIMEOUT=300
PLATFORM_MODEL_TIMEOUT=90
PLATFORM_MAX_RUN_COST=1

# Direct Compose deployment. Managed make start generates private, persistent
# credentials under .data/local/gateway/.env.control instead.
POSTGRES_PASSWORD=
PLATFORM_DB_PASSWORD=
# A separate schema owner credential, available to migration/init only.
PLATFORM_MIGRATION_DB_PASSWORD=
# Optional complete URLs for passwords containing reserved URI characters.
# Compose defaults to platform_runtime and platform_migrator on postgres:5432.
PLATFORM_RUNTIME_DATABASE_URL=
PLATFORM_MIGRATION_DATABASE_URL=
LITELLM_DB_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
UI_USERNAME=admin
UI_PASSWORD=
LITELLM_HTTP_PORT=4000
# Example upstream: any compatible Chat Completions provider, routed by LiteLLM.
UPSTREAM_MODEL=openai/gpt-4o-mini
UPSTREAM_API_BASE=https://api.openai.com/v1
UPSTREAM_API_KEY=
# Alias presented by LiteLLM; create the same alias in the platform model catalog.
LITELLM_MODEL_ALIAS=platform-chat
# One-time gateway key limits. They do not credit the platform wallet.
GATEWAY_KEY_MAX_BUDGET=100
GATEWAY_KEY_RPM=60
GATEWAY_KEY_TPM=120000
GATEWAY_KEY_CONCURRENT=4
PLATFORM_HTTP_PORT=8000
# Direct SaaS Compose requires an external volume, created before first startup:
# docker volume create agent-platform-tenant-tombstones
# Keep this volume outside PostgreSQL backup/restore and never reset it on restore.
PLATFORM_TOMBSTONE_VOLUME=agent-platform-tenant-tombstones
# Compose enables secure cookies: place an HTTPS reverse proxy before API.
# Existing PostgreSQL volumes need an explicit owner/role migration; the new
# bootstrap-roles.sh initializes fresh volumes and does not rewrite old owners.
