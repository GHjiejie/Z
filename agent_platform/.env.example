# Local development. Copy to agent_platform/.env and replace blank secrets.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=
PLATFORM_DATABASE_URL=sqlite:///agent_platform/.data/platform.db
PLATFORM_REDIS_URL=
PLATFORM_LITELLM_URL=
PLATFORM_LITELLM_KEY=
PLATFORM_EMBEDDED_WORKER=true
PLATFORM_SECURE_COOKIES=false
PLATFORM_RUN_TIMEOUT=300
PLATFORM_MODEL_TIMEOUT=90
PLATFORM_MAX_RUN_COST=1

# Compose only. Generate independent hexadecimal secrets for database passwords.
POSTGRES_PASSWORD=
PLATFORM_DB_PASSWORD=
LITELLM_DB_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
# Example upstream: any compatible Chat Completions provider, routed by LiteLLM.
UPSTREAM_MODEL=openai/gpt-4o-mini
UPSTREAM_API_BASE=https://api.openai.com/v1
UPSTREAM_API_KEY=
# Alias presented by LiteLLM; create the same alias in the platform model catalog.
LITELLM_MODEL_ALIAS=platform-chat
# One-time gateway key limits. They do not credit the platform wallet.
GATEWAY_KEY_MAX_BUDGET=100
GATEWAY_KEY_RPM=60
GATEWAY_KEY_TPM=120000
GATEWAY_KEY_CONCURRENT=4
PLATFORM_HTTP_PORT=8000
